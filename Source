                            lastMenuBindTime = tick()
                            connection:Disconnect()
                            task.defer(function()
                                ignoreMenuToggleAfterBinding = false
                            end)
                        end
                    end)
                end)
            end
            settingsFrame.Visible = true
            topBarLabel.Text = buttonText
        else
            local sectionFrame = contentFrame:FindFirstChild(buttonText .. "Frame")
            if not sectionFrame then
                sectionFrame = Instance.new("Frame")
                sectionFrame.Name = buttonText .. "Frame"
                sectionFrame.Size = UDim2.new(1, 0, 1, 0)
                sectionFrame.BackgroundTransparency = 1
                sectionFrame.Parent = contentFrame
            end
            topBarLabel.Text = buttonText
            sectionFrame.Visible = true
        end
    end)
end

