                keepSentinelButton.Name = "KeepSentinelButton"
                keepSentinelButton.Text = "Keep Sentinel Hub: Yes"
                keepSentinelButton.Size = UDim2.new(0, 200, 0, 80)
                keepSentinelButton.Position = UDim2.new(0, 113, 0, -75)
                keepSentinelButton.BackgroundColor3 = Color3.fromRGB(40,40,40)
                keepSentinelButton.BorderSizePixel = 0
                keepSentinelButton.TextSize = 13
                keepSentinelButton.TextColor3 = Color3.fromRGB(255,255,255)
                keepSentinelButton.Parent = settingsFrame

                local keepSentinelCorner = Instance.new("UICorner")
                keepSentinelCorner.CornerRadius = UDim.new(0,10)
                keepSentinelCorner.Parent = keepSentinelButton

                keepSentinelButton.MouseButton1Click:Connect(function()
                    isSentinelKept = not isSentinelKept
                    if isSentinelKept then
                        keepSentinelButton.Text = "Keep Sentinel Hub: Yes"
                    else
                        keepSentinelButton.Text = "Keep Sentinel Hub: No"
                    end
                end)

                local menuButton = Instance.new("TextButton")
                menuButton.Name = "MenuButton"
                menuButton.Text = "Menu\nKey: ..."
                menuButton.Size = UDim2.new(0, 200, 0, 80)
                menuButton.Position = UDim2.new(0, -327, 0, -75)
                menuButton.BackgroundColor3 = Color3.fromRGB(40,40,40)
                menuButton.BorderSizePixel = 0
                menuButton.TextSize = 14
                menuButton.TextColor3 = Color3.fromRGB(255,255,255)
                menuButton.Parent = settingsFrame

                local menuCorner = Instance.new("UICorner")
                menuCorner.CornerRadius = UDim.new(0,10)
                menuCorner.Parent = menuButton

                menuButton.MouseButton1Click:Connect(function()
                    menuButton.Text = "Press a key..."
                    isBindingMenuKey = true
                    ignoreMenuToggleAfterBinding = true
                    local connection
                    connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
                            menuKeyBind = input.KeyCode
                            menuButton.Text = "Menu\nKey: " .. menuKeyBind.Name
                            isBindingMenuKey = false
                            lastMenuBindTime = tick()
                            connection:Disconnect()
                            task.defer(function()
                                ignoreMenuToggleAfterBinding = false
                            end)
                        end
                    end)
                end)
            end
            settingsFrame.Visible = true
            topBarLabel.Text = buttonText
        else
            local sectionFrame = contentFrame:FindFirstChild(buttonText .. "Frame")
            if not sectionFrame then
                sectionFrame = Instance.new("Frame")
                sectionFrame.Name = buttonText .. "Frame"
                sectionFrame.Size = UDim2.new(1, 0, 1, 0)
                sectionFrame.BackgroundTransparency = 1
                sectionFrame.Parent = contentFrame
            end
            topBarLabel.Text = buttonText
            sectionFrame.Visible = true
        end
    end)
end

