local function enableAntiFling()
    if antifling then return end

    antifling = RunService.Stepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Players.LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if originalCollision[part] == nil then
                            originalCollision[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

local function disableAntiFling()
    if not antifling then return end
    antifling:Disconnect()
    antifling = nil
    for part, originalState in pairs(originalCollision) do
        if part.Parent then -- evita errori se la parte è stata distrutta
            part.CanCollide = originalState
        end
    end
    table.clear(originalCollision)
end

local function enableNoClip()
    if NoClipconnection then
        NoClipconnection:Disconnect()
        NoClipconnection = nil
    end
    NoClipconnection = RunService.Stepped:Connect(function()
        local character = game.Players.LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if originalCollision[part] == nil then
                        originalCollision[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function disableNoClip()
    if NoClipconnection then
        NoClipconnection:Disconnect()
        NoClipconnection = nil
    end
    local character = game.Players.LocalPlayer.Character
    if character then
        for part, collide in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = collide
            end
        end
    end
    table.clear(originalCollision)
end

local features = {
    AntiFling = {
        enabled = function() return isAntiFlingEnabled end,
        disable = function()
            disableAntiFling()
            isAntiFlingEnabled = false
        end
    },
    NoClip = {
        enabled = function() return isNoClipEnabled end,
        disable = function()
            disableNoClip()
            isNoClipEnabled = false
        end
    }
}

