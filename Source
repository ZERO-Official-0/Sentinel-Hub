local function enableAntiFling()
    if antifling then return end

    antifling = RunService.Stepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Players.LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if originalCollision[part] == nil then
                            originalCollision[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

local function disableAntiFling()
    if not antifling then return end
    antifling:Disconnect()
    antifling = nil
    for part, originalState in pairs(originalCollision) do
        if part.Parent then -- evita errori se la parte è stata distrutta
            part.CanCollide = originalState
        end
    end
    table.clear(originalCollision)
end

local function enableNoClip()
    if NoClipconnection then
        NoClipconnection:Disconnect()
        NoClipconnection = nil
    end
    NoClipconnection = RunService.Stepped:Connect(function()
        local character = game.Players.LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if originalCollision[part] == nil then
                        originalCollision[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function disableNoClip()
    if NoClipconnection then
        NoClipconnection:Disconnect()
        NoClipconnection = nil
    end
    local character = game.Players.LocalPlayer.Character
    if character then
        for part, collide in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = collide
            end
        end
    end
    table.clear(originalCollision)
end

local function enableInfJump()
    if InfJump then return end

    InfJump = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end

        if input.KeyCode ~= Enum.KeyCode.Space then
            return
        end

        local character = player.Character
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            return
        end

        if humanoid:GetState() == Enum.HumanoidStateType.Dead then
            return
        end

        humanoid.Jump = false
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

        task.delay(0.05, function()
            if character and character.Parent and humanoid.Parent == character and humanoid.Health > 0 then
                humanoid.Jump = false
            end
        end)
    end)
end

local function disableInfJump()
    if not InfJump then return end
    InfJump:Disconnect()
    InfJump = nil
end

local function EnableInfiniteZoom()
	if isInfiniteZoomEnabled then return end
	isInfiniteZoomEnabled = true
	if not saved then
		saved = {
			min = player.CameraMinZoomDistance,
			max = player.CameraMaxZoomDistance,
		}
	end
	player.CameraMinZoomDistance = 0
	player.CameraMaxZoomDistance = 1e9
end

local function DisableInfiniteZoom()
	if not isInfiniteZoomEnabled then return end
	isInfiniteZoomEnabled = false
	if saved then
		player.CameraMinZoomDistance = saved.min
		player.CameraMaxZoomDistance = saved.max
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 400
	end
	saved = nil
end

